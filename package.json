{
  "name": "allison-web-iptv",
  "productName": "Allison Web IPTV",
  "version": "0.1.0",
  "description": "Self-hosted web service for Xtream Codes/M3U IPTV providers — a browser-based sibling of the AllisonIPTV desktop app.",
  "private": true,
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vitest": "^4.1.11"
  }
}

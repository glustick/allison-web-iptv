{
  "name": "allison-web-iptv",
  "productName": "Allison Web IPTV",
  "version": "0.4.4",
  "description": "Self-hosted web service for Xtream Codes/M3U IPTV providers — a browser-based sibling of the AllisonIPTV desktop app.",
  "private": true,
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.19.2",
    "fast-xml-parser": "^5.11.1",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
